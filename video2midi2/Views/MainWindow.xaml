<Window x:Class="Video2Midi2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:Video2Midi2.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfskia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Video2Midi" Height="720" Width="1280"
        MinHeight="400" MinWidth="640"
        Background="#1E1E1E">

    <Window.Resources>
        <local:RgbColorToBrushConverter  x:Key="RgbToBrush"/>
        <BooleanToVisibilityConverter    x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Swatch button style — the clickable color box -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width"           Value="18"/>
            <Setter Property="Height"          Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <!-- Dark button style used throughout -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eyedropper button style -->
        <Style x:Key="EyedropButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Width"   Value="22"/>
            <Setter Property="Height"  Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTip" Value="Eyedropper — click then click on the video"/>
        </Style>

        <!-- Accent button for the Reconstruct action -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#569CD6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4A88BE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>

        <!-- Label style for the toolbar -->
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value readout next to sliders -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu bar -->
            <RowDefinition Height="Auto"/>
            <!-- Tab bar -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Video canvas -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
      Background="#252525"
      Foreground="#CCCCCC"
      BorderBrush="#3A3A3A"
      BorderThickness="0,0,0,1"
      FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="#252525"/>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="_File">
                <MenuItem Header="_Open video file..."
                  Command="{Binding OpenFileCommand}"
                  InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open video from URL..."
                  Command="{Binding OpenUrlCommand}"/>
                <Separator/>
                <MenuItem Header="_Save settings"
                  Command="{Binding SaveSettingsCommand}"
                  InputGestureText="F2"/>
                <MenuItem Header="_Load settings"
                  Command="{Binding LoadSettingsCommand}"
                  InputGestureText="F3"/>
                <Separator/>
                <MenuItem Header="E_xit"
                  Command="{Binding ExitCommand}"
                  InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_View Hotkeys"
                  Command="{Binding ShowHelpWindowCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════════════════════════════════════════════════
             ROW 1 — Tab bar
             ═══════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    Background="#2D2D2D"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#444444">

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <!-- SettingsPanel UserControl goes here once built -->
                <TextBlock Text="Settings panel — coming soon"
                           Foreground="#666" Margin="12" FontSize="12"/>
            </TabItem>

            <!-- Colors Tab -->
            <TabItem Header="Colors">
                <TextBlock Text="Color map panel — coming soon"
                           Foreground="#666" Margin="12" FontSize="12"/>
            </TabItem>

            <!-- Sparks Tab -->
            <TabItem Header="Sparks">
                <TextBlock Text="Sparks panel — coming soon"
                           Foreground="#666" Margin="12" FontSize="12"/>
            </TabItem>

            <!-- Extra Tab -->
            <TabItem Header="Extra">
                <TextBlock Text="Extra panel — coming soon"
                           Foreground="#666" Margin="12" FontSize="12"/>
            </TabItem>

            <!-- Reconstruct button pinned to the right of the tab bar -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#2D2D2D">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="▶  Reconstruct"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,8,4"
                                    Command="{Binding StartReconstructionCommand}"/>
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#444444"
                                BorderThickness="0,1,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════
             ROW 1 — Toolbar (nav + quick controls)
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
        Background="#2D2D2D"
        BorderBrush="#444444"
        BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Existing quick controls row -->
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quick controls: sensitivity, tempo, octave -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14">

                        <!-- Sensitivity slider -->
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Sensitivity" Style="{StaticResource ToolbarLabel}"/>
                            <Slider Width="80" Minimum="0" Maximum="130"
                Value="{Binding Prefs.Sensitivity}"
                VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Prefs.Sensitivity}"
                   Style="{StaticResource ValueLabel}"/>
                        </StackPanel>

                        <!-- Tempo changer -->
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Tempo" Style="{StaticResource ToolbarLabel}"/>
                            <xctk:IntegerUpDown Value="{Binding Prefs.Tempo}"
                            Minimum="30" 
                            Maximum="240"
                            Margin="5,0" Background="#FF2D2D2D" Foreground="#FFCCCCCC" CaretBrush="#FFCCCCCC"
                            />

                        </StackPanel>

                        <!-- Octave stepper -->
                        <StackPanel Orientation="Horizontal" Margin="3">
                            <TextBlock Text="Octave" Style="{StaticResource ToolbarLabel}"/>
                            <Button Content="−" Style="{StaticResource DarkButton}"
                Width="22" Padding="0"
                Command="{Binding LowerOctaveCommand}"/>
                            <TextBlock Text="{Binding Prefs.Octave}"
                   Style="{StaticResource ValueLabel}"
                   TextAlignment="Center" MinWidth="18"/>
                            <Button Content="+" Style="{StaticResource DarkButton}"
                Width="22" Padding="0"
                Command="{Binding RaiseOctaveCommand}"/>
                        </StackPanel>

                    </StackPanel>


                <!-- Color channel strip -->
                <Border Grid.Column="1" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0"
                Padding="8,4">
                    <DockPanel>

                        <TextBlock DockPanel.Dock="Left"
                           Text="Channels"
                           Foreground="#666666"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                        <!-- Channel items -->
                        <ItemsControl DockPanel.Dock="Left"
                              ItemsSource="{Binding ColorMap.VisibleChannels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,2">
                                        <StackPanel Orientation="Horizontal" Margin="3">

                                            <!-- Channel label -->
                                            <TextBlock Text="{Binding Label}"
                                               Foreground="#777777"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               MinWidth="24"/>

                                            <!-- Light color swatch -->
                                            <Button Style="{StaticResource SwatchButton}"
                                            Background="{Binding Entry.Light, Converter={StaticResource RgbToBrush}}"
                                            Command="{Binding PickLightColorCommand}"
                                            ToolTip="Light color — click to change"/>

                                            <!-- Dark color swatch -->
                                            <Button Style="{StaticResource SwatchButton}"
                                            Background="{Binding Entry.Dark, Converter={StaticResource RgbToBrush}}"
                                            Command="{Binding PickDarkColorCommand}"
                                            ToolTip="Dark color — click to change"/>

                                                <!-- Remove -->
                                            <Button Style="{StaticResource DarkButton}"
                                            Content="✕"
                                            FontSize="9"
                                            Width="16" Height="16"
                                            Padding="0"
                                            Foreground="#666666"
                                            Command="{Binding DataContext.ColorMap.RemoveChannelCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove channel"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add button -->
                        <Button DockPanel.Dock="Left"
                        Content="+ Add"
                        Style="{StaticResource DarkButton}"
                        Margin="4,0,0,0"
                        Command="{Binding ColorMap.AddChannelCommand}"/>

                        <!-- Separator -->
                        <Rectangle DockPanel.Dock="Left"
                           Width="1" Fill="#444444" Margin="6,0"/>

                        <!-- Expand/collapse toggle -->
                        <Button DockPanel.Dock="Left"
                        Content="{Binding ColorMap.ToggleLabel}"
                        Style="{StaticResource DarkButton}"
                        Command="{Binding ColorMap.ToggleExpandedCommand}"/>

                    </DockPanel>
                </Border>
                </Grid>

                <!-- Eyedropper active banner — shown while sampling -->
                <Border Background="#1A3A1A"
        BorderBrush="#2D6A2D"
        BorderThickness="0,1,0,0"
        Padding="8,5"
        Visibility="{Binding ColorMap.IsEyedropping,
                     Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>

                        <!-- Cancel button -->
                        <Button DockPanel.Dock="Right"
                Content="Cancel"
                Style="{StaticResource DarkButton}"
                Click="CancelEyedrop_Click"
                Margin="0,0,4,0"/>

                        <!-- Live color preview swatch + hex value -->
                        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                            <Border Width="18" Height="18"
                    CornerRadius="3"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Background="{Binding ColorMap.LivePreviewColor,
                                 Converter={StaticResource RgbToBrush}}"
                    Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ColorMap.LivePreviewHex}"
                       Foreground="#AAAAAA"
                       FontFamily="Consolas"
                       FontSize="11"
                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Instruction text -->
                        <TextBlock Text="⊕  Click on the video to sample a color  —  move cursor to preview"
                   Foreground="#88CC88"
                   FontSize="11"
                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

            </StackPanel>
        </Border>
          <!-- ═══════════════════════════════════════════════════════
             ROW 2 — Video canvas (SKElement + progress bar)
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- SkiaSharp canvas -->
                <RowDefinition Height="Auto"/>
                <!-- Progress bar -->
            </Grid.RowDefinitions>

            <!-- SkiaSharp render surface — video frame + key overlays drawn here -->
            <wpfskia:SKElement Grid.Row="0"
                               x:Name="MainCanvas"
                               PaintSurface="MainCanvas_PaintSurface"/>

            <!-- Seekbar and progress bar-->
            <Grid Grid.Row="1" Background="#1A1A1A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Seek bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Progress bar (reconstruction only) -->
                </Grid.RowDefinitions>

                <!-- Seek bar — always visible -->
                <Grid Grid.Row="1" Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0"
                x:Name="SeekSlider"
                Minimum="0"
                Maximum="{Binding SeekMax}"
                Value="{Binding CurrentFrameIndex, Mode=TwoWay}"
                VerticalAlignment="Center"
                IsMoveToPointEnabled="True"
                ValueChanged="SeekSlider_ValueChanged"
                            Cursor="Hand"/>

                    <TextBlock Grid.Column="1"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="#888888"
                   Text="{Binding FrameCounterDisplay}"/>
                </Grid>

                <!-- Reconstruction progress — only visible while processing -->
                <Grid Grid.Row="0"
          Visibility="{Binding IsProcessing,
                       Converter={StaticResource BoolToVisibility}}"
          Height="6">
                    <ProgressBar Value="{Binding ProcessingProgress}"
                     Minimum="0" Maximum="1"
                     Foreground="#569CD6"
                     Background="#333333"
                     BorderThickness="0"/>
                </Grid>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════
     ROW 4 — Status bar
     ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
        Background="#252525"
        BorderBrush="#3A3A3A"
        BorderThickness="0,1,0,0"
        Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Status message -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nav buttons (centered) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Video info -->
                </Grid.ColumnDefinitions>

                <!-- Left — status message -->
                <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Foreground="#666666"
                   FontSize="11"
                   VerticalAlignment="Center"/>

                <!-- Center — nav buttons -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" Cursor="Hand">
                    <Button Content="|◀" Style="{StaticResource DarkButton}"
                    ToolTip="Go to start (Home)"
                    Command="{Binding ScrollToStartCommand}"/>
                    <Button Content="◀◀" Style="{StaticResource DarkButton}"
                    ToolTip="Fast rewind (PageDown)"
                    Command="{Binding ScrollFastBackCommand}"/>
                    <Button Content="◀" Style="{StaticResource DarkButton}"
                    ToolTip="Previous frame (Shift+PageDown)"
                    Command="{Binding ScrollBackOneFrameCommand}"/>
                    <Button Content="▶" Style="{StaticResource DarkButton}"
                    ToolTip="Next frame (Shift+PageUp)"
                    Command="{Binding ScrollForwardOneFrameCommand}"/>
                    <Button Content="▶▶" Style="{StaticResource DarkButton}"
                    ToolTip="Fast forward (PageUp)"
                    Command="{Binding ScrollFastForwardCommand}"/>
                    <Button Content="▶|" Style="{StaticResource DarkButton}"
                    ToolTip="Go to end (End)"
                    Command="{Binding ScrollToEndCommand}"/>
                </StackPanel>

                <!-- Right — video info -->
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="16">
                    <TextBlock Text="{Binding VideoResolution}"
                       Style="{StaticResource ToolbarLabel}"
                               Margin="5"/>
                    <TextBlock Text="{Binding VideoFps, StringFormat='{}{0:F0} fps'}"
                       Style="{StaticResource ToolbarLabel}"
                               Margin="5"/>
                    <TextBlock Text="{Binding FrameRangeDisplay}"
                       Style="{StaticResource ToolbarLabel}"
                               Margin="5"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>